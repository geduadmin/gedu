# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project → Settings → Environment Variables
# (DATABASE_URL and the Blob variables are added automatically when you connect the stores).

# Neon Postgres connection string (added by the Neon integration)
DATABASE_URL=

# Random string, at least 32 characters — signs the login cookie
SESSION_SECRET=

# First admin account, created once when the database has no users
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional display name for that admin (default: Sarah Aljani)
ADMIN_NAME=

# Vercel Blob (private store) — added automatically when the store is connected.
# For local development outside Vercel, use the store's read-write token:
# BLOB_READ_WRITE_TOKEN=
